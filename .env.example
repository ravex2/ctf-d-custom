# Copy this file to .env and replace every value before starting the stack.
# Do not commit .env: it contains credentials.

# Generate locally, for example: openssl rand -hex 32
CTFD_SECRET_KEY=replace-with-a-long-random-secret
MARIADB_ROOT_PASSWORD=replace-with-a-long-random-secret
MARIADB_PASSWORD=replace-with-a-long-random-secret

# Cloudflare Zero Trust Dashboard -> Networks -> Tunnels -> your tunnel ->
# Install and run a connector. Copy only the token in the Docker command.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-the-cloudflare-tunnel-token
